---
import '../styles/global.css';
import ContactCTA from '../components/ContactCTA.astro';
import { site } from '../config';

interface Props {
	title?: string;
	description?: string;
	/** Absolute or root-relative image for social previews. */
	image?: string;
}

const { title = site.seoTitle, description = site.description, image = site.ogImage } =
	Astro.props;

// Absolute URLs — required for canonical, Open Graph, and JSON-LD.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// Person entity — the strongest signal that this domain IS "Piyush Tater".
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	url: site.url,
	jobTitle: site.jobTitle,
	email: `mailto:${site.contact.email}`,
	sameAs: site.sameAs,
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<main id="main">
			<slot />
		</main>
		<footer>
			<ContactCTA />
		</footer>
		<script>
			// Mascot chat — lazy, after the page is idle, so it never competes
			// with the hero/poster for LCP. JS-only enhancement by design.
			const idle =
				'requestIdleCallback' in window
					? (cb: () => void) => requestIdleCallback(cb, { timeout: 3000 })
					: (cb: () => void) => setTimeout(cb, 1500);
			addEventListener(
				'load',
				() =>
					idle(async () => {
						const { mascotChat } = await import('../scripts/mascot-chat');
						mascotChat();
					}),
				{ once: true }
			);
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: -9999px;
		top: 0;
		font-family: var(--font-mono);
		background: var(--bg-raised);
		padding: 0.5rem 1rem;
		z-index: 10;
	}
	.skip:focus {
		left: 0;
	}
	main,
	footer {
		width: min(100% - 3rem, 72rem);
		margin-inline: auto;
	}
</style>
